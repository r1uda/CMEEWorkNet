# Copy to .env; the application reads it on startup. Never commit real secrets.
APP_URL=http://127.0.0.1:8765
DATABASE_PATH=data/workbench.sqlite3
COOKIE_SECURE=false
HOST=127.0.0.1
PORT=8765
# Production: HTTPS origin and COOKIE_SECURE=true; set HOST behind a reverse proxy.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# DeepSeek official OpenAI-compatible endpoint. Fill the key only in local .env.
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_API_KEY=
AI_DAILY_LIMIT=30
